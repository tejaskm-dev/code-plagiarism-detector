<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.tejaskm-dev</groupId>
    <artifactId>integrity-engine-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>integrity-engine-core</artifactId>
  <packaging>jar</packaging>

  <name>Integrity Engine</name>
  <description>
    Java library for source-code plagiarism detection: tokenizers for Java, Python, C, C++
    and JavaScript, winnowing fingerprints, boilerplate suppression, cohort-relative outlier
    flagging, and an offline AI-authorship model. No required runtime dependencies.
  </description>

  <dependencies>
    <!--
      Only needed for SQLite persistence via RepositoryFactory. Optional, so a library
      user who analyses in memory (new IntegrityEngine()) pulls in nothing at all.
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Publish a self-contained POM: license, developers and SCM inlined, the parent
        removed and dependency versions resolved, so consumers and Maven Central need
        nothing beyond this one file.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>ossrh</flattenMode>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- A stable module name for consumers on the module path. -->
              <Automatic-Module-Name>com.integrityengine</Automatic-Module-Name>
              <Implementation-Title>${project.name}</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- Keep broken links and bad HTML as warnings; drop demands for a tag on every member. -->
          <doclint>all,-missing</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
